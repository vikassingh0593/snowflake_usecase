# Secrets — never commit
.env
.env.*
!.env.example
rsa_key*
*.p8
*.pem
*.pfx
snowflake_credentials.json
.snowflake/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# dbt. dbt_packages/ was described here as committed on purpose, so that
# Snowflake Workspaces -- which cannot reach the internet without an external
# access integration -- could run the project as-is. Nothing in this project
# runs dbt inside Snowflake: it runs in a pinned container locally and on
# GitHub Actions, both of which have a network. The justification was for a
# path that does not exist, and the price was 229 files of third-party code.
#
# package-lock.yml IS committed, and is the part that was actually load-bearing:
# it pins the resolved version, so scripts/dbt.sh and CI install the same
# dbt_utils. scripts/dbt.sh runs `dbt deps` by itself when dbt_packages/ is
# absent, so a fresh clone needs no extra step.
target/
logs/
dbt_modules/
dbt_packages/

# Local data / scratch
*.log
data/generated/
*.parquet
*.ndjson.gz

# OS / editor
.DS_Store
.idea/
.vscode/

# generated source data — regenerate with source/generate.py
source/out/

# Kafka connector jar — 170 MB, fetched by scripts/p3_connector.sh
source/connectors/plugins/**/*.jar

# Public keys. Not secret, but not repo content either: every reference in this
# repo regenerates them from the .p8, and the .p8 is ignored above.
#   openssl rsa -in rsa_kafka.p8 -pubout -out rsa_kafka.pub
*.pub

# dbt's per-machine anonymous-usage id
dbt/.user.yml
