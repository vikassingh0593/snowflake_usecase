# Secrets — never commit
.env
.env.*
!.env.example
rsa_key*
*.p8
*.pem
*.pfx
snowflake_credentials.json
.snowflake/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# dbt — target and logs only. dbt_packages/ IS committed on purpose:
# running `dbt deps` inside Snowflake Workspaces needs an external access
# integration (UNVERIFIED; avoided).
target/
logs/
dbt_modules/

# Local data / scratch
*.log
data/generated/
*.parquet
*.ndjson.gz

# OS / editor
.DS_Store
.idea/
.vscode/

# generated source data — regenerate with source/generate.py
source/out/

# Kafka connector jar — 170 MB, fetched by scripts/p3_connector.sh
source/connectors/plugins/**/*.jar

# Public keys. Not secret, but not repo content either: every reference in this
# repo regenerates them from the .p8, and the .p8 is ignored above.
#   openssl rsa -in rsa_kafka.p8 -pubout -out rsa_kafka.pub
*.pub

# dbt's per-machine anonymous-usage id
dbt/.user.yml
