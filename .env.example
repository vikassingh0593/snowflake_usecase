# Copy to .env and fill in. .env is gitignored. NEVER put a password in here —
# key-pair auth only, for every user including the human one.

# --- Snowflake -------------------------------------------------------------
SNOWFLAKE_ACCOUNT=AWTTGVH-OLB61128
SNOWFLAKE_HOST=awttgvh-olb61128.snowflakecomputing.com
SNOWFLAKE_REGION=aws_us_west_2

# Human/admin user (key-pair)
SNOWFLAKE_USER=<your_login_name>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=WH_TRANSFORM_XS
SNOWFLAKE_DATABASE=QCOMMERCE
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Service users (TYPE = SERVICE, key-pair only)
SVC_KAFKA_USER=SVC_KAFKA
SVC_KAFKA_ROLE=QC_LOADER
SVC_KAFKA_PRIVATE_KEY_PATH=./rsa_key_kafka.p8

SVC_CI_USER=SVC_CI
SVC_CI_ROLE=QC_ENGINEER
SVC_CI_PRIVATE_KEY_PATH=./rsa_key_ci.p8

# --- Azure -----------------------------------------------------------------
AZURE_TENANT_ID=<fill in: az account show --query tenantId -o tsv>
AZURE_TENANT_DOMAIN=vikassingh0593gmail.onmicrosoft.com
AZURE_SUBSCRIPTION_ID=d27ba827-26e0-419a-bc0b-2b1015e641bb
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=rg-qcpoc
AZURE_STORAGE_ACCOUNT=<set in Part 1: reused snowflakefreeedition, or a fresh snowflakeqcpoc*>
AZURE_QUEUE=snowpipe-queue
# Containers: landing, archive, external, docs

# --- Redpanda / Kafka Connect (Part 2) -------------------------------------
REDPANDA_BROKERS=localhost:19092
KAFKA_CONNECT_URL=http://localhost:8083
KAFKA_TOPIC_ORDER_STATUS=qc.order_status
KAFKA_TOPIC_RIDER_PING=qc.rider_ping

# --- Postgres source (Part 2) ----------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=qcommerce
PGUSER=postgres
PGPASSWORD=<local docker only — never a Snowflake or Azure credential>

# --- External API (mechanism 11) -------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
